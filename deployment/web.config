<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="iisnode.cjs" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NodeBackend" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="iisnode.cjs" />
        </rule>
      </rules>
    </rewrite>
    <iisnode nodeProcessCommandLine="&quot;%HOME%\site\wwwroot\runtime\node.exe&quot;"
             watchedFiles="web.config;iisnode.cjs"
             loggingEnabled="false" debuggingEnabled="false" devErrorsEnabled="false" />
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="runtime" />
          <add segment="node_modules" />
          <add segment="server" />
          <add segment="src" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
