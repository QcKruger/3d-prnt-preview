# Optional: defaults use PayFast's published public sandbox test merchant.
# Copy this file to .env, then set ALL THREE values for your own sandbox merchant.
# The passphrase must match your sandbox dashboard. Never add live keys.
# Keep these server-side. Never use VITE_ prefixes or put this file in public/.
# PAYFAST_SANDBOX_MERCHANT_ID=
# PAYFAST_SANDBOX_MERCHANT_KEY=
# PAYFAST_SANDBOX_PASSPHRASE=

PAYFAST_RETURN_URL=https://qckruger.github.io/3d-prnt-preview/
PAYFAST_CANCEL_URL=https://qckruger.github.io/3d-prnt-preview/

# Only enable on an HTTPS deployment whose proxy enforces HTTPS.
# This sets HSTS; it does not configure TLS or an HTTPS redirect.
# SECURITY_HTTPS_ONLY=true

# Required when HOST binds a public interface; HTTPS origin only, no path.
# APP_ORIGIN=https://your-test-host.example

# Cosmos DB for NoSQL: server-only, non-secret identifiers. No account keys.
# All three are needed for production data access; failures log without stopping the site.
# COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com
# COSMOS_DATABASE=YOUR_DATABASE
# COSMOS_CONTAINER=YOUR_CONTAINER
# Defaults to the host's system-assigned managed identity (no client ID).
# COSMOS_AUTH_MODE=managed-identity
# npm run dev uses bundled local development content; deployed processes use Cosmos only.
